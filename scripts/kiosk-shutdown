#!/bin/bash
# Scheduled low-power shutdown with RTC wake for kiosk Pis
# Runs as root


set -e

RTC="/sys/class/rtc/rtc0/wakealarm"
WAKE_HOUR=7          # Change these two lines to your desired wake time
WAKE_MINUTE=30

# Must be root
if [ "$(id -u)" -ne 0 ]; then
    echo "Must be run as root"
    exit 1
fi

# Clear any existing alarm
echo 0 > "$RTC"

# Calculate absolute Unix timestamp for the next occurrence of the wake time
WAKE_EPOCH=$(date -d "today ${WAKE_HOUR}:${WAKE_MINUTE}" +%s)

# If that time has already passed today, schedule for tomorrow
NOW=$(date +%s)
if [ "$WAKE_EPOCH" -le "$NOW" ]; then
    WAKE_EPOCH=$(date -d "tomorrow ${WAKE_HOUR}:${WAKE_MINUTE}" +%s)
fi

# Write the absolute timestamp
echo "$WAKE_EPOCH" > "$RTC"

# Log for debugging (optional)
logger "Kiosk RTC wake set for $(date -d @$WAKE_EPOCH)"

# Enter the low-power halt state
/sbin/halt