#!/bin/bash
# Reliable RTC wake using relative offset (the method that works on Pi 5)

set -e

RTC="/sys/class/rtc/rtc0/wakealarm"

# === CONFIGURE YOUR TIMES HERE ===
WAKE_HOUR=7           # When the Pi should wake up
WAKE_MINUTE=30
# =================================

if [ "$(id -u)" -ne 0 ]; then
    echo "This script must run as root"
    exit 1
fi

# Clear any previous alarm
echo 0 > "$RTC"

# Calculate how many seconds until the next wake time
NOW=$(date +%s)
WAKE_TODAY=$(date -d "today ${WAKE_HOUR}:${WAKE_MINUTE}" +%s)

if [ "$WAKE_TODAY" -gt "$NOW" ]; then
    # Wake time is still later today
    SECONDS_UNTIL_WAKE=$((WAKE_TODAY - NOW))
else
    # Wake time has already passed → schedule for tomorrow
    WAKE_TOMORROW=$(date -d "tomorrow ${WAKE_HOUR}:${WAKE_MINUTE}" +%s)
    SECONDS_UNTIL_WAKE=$((WAKE_TOMORROW - NOW))
fi

# Write the relative offset (this is the form that works reliably)
echo "+${SECONDS_UNTIL_WAKE}" > "$RTC"

# Verify
echo "RTC wakealarm set to: $(cat $RTC)"
echo "Will wake in ${SECONDS_UNTIL_WAKE} seconds ($(date -d @$((NOW + SECONDS_UNTIL_WAKE))))"

logger "Kiosk RTC relative wake set: +${SECONDS_UNTIL_WAKE}s"

# Enter low-power state
/sbin/halt